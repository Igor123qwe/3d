# Ключ ИИ-роутера. Живёт только на сервере: в браузер не попадает никогда.
# Получить: https://routerai.ru (оплата в рублях, API совместим с OpenAI).
ROUTERAI_API_KEY=sk-...

# Необязательно: другой шлюз с тем же форматом API (OpenRouter, свой прокси).
# ROUTERAI_BASE_URL=https://routerai.ru/api/v1

# Под каждую задачу своя цепочка моделей, от дешёвой к дорогой, через запятую.
# Следующая модель берётся, только если предыдущая не справилась.
# Список доступных моделей: GET /api/ai?models=1
# AI_MODEL_PLAN=google/gemini-2.5-flash,openai/gpt-5-mini,anthropic/claude-sonnet-5
# AI_MODEL_PRODUCT=google/gemini-2.5-flash-lite,openai/gpt-5-nano,deepseek/deepseek-chat
# AI_MODEL_LAYOUT=deepseek/deepseek-chat,openai/gpt-5-mini,anthropic/claude-sonnet-5
# AI_MODEL_CLASSIFY=google/gemini-2.5-flash-lite,openai/gpt-5-nano
# AI_MODEL_CRITIQUE=openai/gpt-5-mini,deepseek/deepseek-chat

# Потолок расходов за сутки, ₽. 0 или пусто — без ограничения.
# AI_DAILY_LIMIT_RUB=100
